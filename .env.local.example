# Kullanim: cp .env.local.example .env.local

# FastAPI backend adresi (/api prefix'i dahil).
# Docker'da compose bunu http://backend:8000/api ile eziyor;
# bu deger yalnizca `pnpm dev` ile yerel calistirmada gecerli.
NEXT_PUBLIC_API_BASE=http://localhost:8004/api

# Sunucu tarafi API anahtari. Next.js sunucusunda kalir, tarayiciya
# gitmez; tum ekip bu anahtarla ayni veriyi paylasir. Kimlik oturumdan gelir.
# Uretmek icin: POST /api/admin/keys?name=...
SEARCH_API_KEY=


# Opsiyonel. Hata raporlarina eklenen surum etiketi (varsayilan 2.0.0).
# NEXT_PUBLIC_APP_VERSION=2.0.0

# --- Kimlik (Auth.js) ---
# Uret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Auth tablolari ve onayli e-posta listesi (backend ile ayni Postgres).
DATABASE_URL=postgresql://postgres:aiesec@127.0.0.1:55432/aiesec
# Her zaman yonetici olan adresler (virgulle ayrilmis).
ADMIN_EMAILS=
# /admin sayfalari icin backend yonetici anahtari (backend/.env ile ayni).
ADMIN_API_KEY=
# Google ile giris (Google Cloud Console > OAuth istemcisi).
# Yonlendirme adresi: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-posta ile giris (Gmail: uygulama sifresi). Bos ise gelistirmede
# giris baglantisi terminale yazilir, uretimde e-posta secenegi gizlenir.
EMAIL_SERVER=
EMAIL_FROM=
