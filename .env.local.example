# Kullanim: cp .env.local.example .env.local

# FastAPI backend adresi (/api prefix'i dahil).
# Docker'da compose bunu http://backend:8000/api ile eziyor;
# bu deger yalnizca `pnpm dev` ile yerel calistirmada gecerli.
NEXT_PUBLIC_API_BASE=http://localhost:8004/api

# Sunucu tarafi arama anahtari.
# Backend /api/search ve /api/export X-API-KEY zorunlu tutuyor. Bu anahtar
# Next.js sunucusunda kalir, tarayiciya gitmez; sayesinde son kullanici
# anahtar girmeden arama yapabilir. Kullanici kendi anahtarini girerse
# (SettingsModal) onunki oncelikli olur.
# Uretmek icin: POST /api/admin/keys?name=web_server&plan=pro
SEARCH_API_KEY=

# Opsiyonel. Redis yoksa cache sessizce bypass moduna gecer.
REDIS_URL=redis://localhost:6379

# Opsiyonel. Hata raporlarina eklenen surum etiketi (varsayilan 2.0.0).
# NEXT_PUBLIC_APP_VERSION=2.0.0
