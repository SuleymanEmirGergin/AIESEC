# FastAPI OSM Backend - ornek yapilandirma
# Kullanim: cp .env.example .env  (sonra ADMIN_API_KEY'i kendin uret)

# Server
PORT=8000
HOST=0.0.0.0

# Overpass API - virgulle ayrilmis mirror listesi (ilki birincil, digerleri failover)
# DIKKAT: yalnizca global kapsamli mirror ekleyin. Bolgesel sunucular
# (orn. overpass.osm.ch - Isvicre) kapsam disi koordinatlar icin hata
# degil HTTP 200 + bos sonuc doner; failover bunu basarili sayar ve
# arama sessizce bos kalir.
OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://z.overpass-api.de/api/interpreter,https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
# Tek bir Overpass denemesinin ust siniri (saniye).
# DIKKAT: bu deger sorgunun dogal suresinden BUYUK olmali. Yogun sehirde
# 5 km yaricapli bir sorgu olcumde ~50-60 sn suruyor; sinir bunun altinda
# kalirsa calisacak sorgu kesilip bastan deneniyor ve toplam sure artiyor
# (60 + 55 = 115 sn). Eski ornek deger 15 idi ve her aramayi bosa
# dusururdu.
OVERPASS_TIMEOUT=90

# Frontend origin'leri (dev sunucusu 3004 portunda calisiyor)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3004

# Rate Limiting
RATE_LIMIT=60/minute

# Cache
CACHE_TTL_SCHOOL=3600
CACHE_TTL_B2B=300

# Security - ASLA gercek deger commit'leme. Uret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=generate-a-secure-key-here

# Logging
LOG_LEVEL=INFO

# Yerel kullanim modu. true ise X-API-KEY zorunlu degil ve kota
# sayaci islemez. Uretimde false birakilmali.
LOCAL_MODE=true

# Ilce sinirina eklenen arama tamponu (metre).
DISTRICT_BUFFER_M=2000
