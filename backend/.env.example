# FastAPI OSM Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0

# Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=15

# Rate Limiting
RATE_LIMIT=60/minute

# Cache
CACHE_TTL_SCHOOL=3600
CACHE_TTL_B2B=300

# Security
ADMIN_API_KEY=generate-a-secure-key-here

# Logging
LOG_LEVEL=INFO
